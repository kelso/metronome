<% playlist_songs = @playlist.songs.rank(:row_order).to_a %>

<div data-controller="playlist-rail" class="grid gap-5 lg:grid-cols-[3.75rem_20rem_minmax(0,1fr)]">
  <aside data-playlist-rail-target="panel" class="panel flex flex-col p-2">
    <div class="mb-5 flex items-center justify-center gap-2">
      <h2 data-playlist-rail-target="expanded" class="hidden flex-1 text-sm font-semibold uppercase tracking-wide text-slate-300">Playlists</h2>
      <button
        type="button"
        data-action="click->playlist-rail#toggle"
        data-playlist-rail-target="toggle"
        class="grid size-9 shrink-0 place-items-center rounded-lg border border-slate-700 bg-slate-950/30 text-lg font-semibold leading-none text-slate-200 transition hover:border-sky-500/60 hover:bg-sky-500/10 hover:text-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-400/40"
        aria-expanded="false"
        title="Expand playlists"
      >
        <span data-playlist-rail-target="collapsed">☰</span>
        <span data-playlist-rail-target="expanded" class="hidden" aria-hidden="true">
          <svg class="size-4" viewBox="0 0 20 20" fill="none">
            <path d="M12 5L7 10L12 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </button>
      <%= link_to new_playlist_path, class: "hidden grid size-9 shrink-0 place-items-center rounded-lg border border-slate-700 bg-slate-950/30 text-slate-200 transition hover:border-sky-500/60 hover:bg-sky-500/10 hover:text-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-400/40", title: "New Playlist", data: { playlist_rail_target: "expanded" } do %>
        <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      <% end %>
    </div>

    <nav class="space-y-1">
      <%= link_to playlists_path, class: "rail-item justify-center px-2", data: { playlist_rail_target: "item" } do %>
        <span data-playlist-rail-target="collapsed" class="font-semibold">≡</span>
        <span data-playlist-rail-target="expanded" class="hidden">All Playlists</span>
        <span data-playlist-rail-target="expanded" class="hidden text-xs text-slate-500"><%= @navigation_playlists.size %></span>
      <% end %>

      <% @navigation_playlists.each do |playlist| %>
        <%= link_to playlist_path(playlist), class: "rail-item justify-center px-2 #{'rail-item-active' if playlist == @playlist}", data: { playlist_rail_target: "item" } do %>
          <span data-playlist-rail-target="collapsed" class="font-semibold"><%= playlist.name.first&.upcase || "P" %></span>
          <span data-playlist-rail-target="expanded" class="hidden truncate"><%= playlist.name %></span>
          <span data-playlist-rail-target="expanded" class="ml-3 hidden text-xs text-slate-500"><%= playlist.songs.size %></span>
        <% end %>
      <% end %>
    </nav>

    <div class="mt-6 border-t border-slate-800 pt-4">
      <%= link_to new_playlist_path, class: "mx-auto grid size-9 place-items-center rounded-lg border border-slate-700 bg-slate-950/30 text-slate-200 transition hover:border-sky-500/60 hover:bg-sky-500/10 hover:text-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-400/40", title: "New Playlist", data: { playlist_rail_target: "collapsed" } do %>
        <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      <% end %>
      <%= link_to "＋ New Playlist", new_playlist_path, class: "btn-outline hidden w-full justify-center", data: { playlist_rail_target: "expanded" } %>
    </div>
  </aside>

  <aside class="panel overflow-hidden">
    <div class="border-b border-slate-800 p-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Songs in <%= @playlist.name %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= playlist_songs.size %> songs</p>
        </div>
        <%= link_to "＋ Add Song", new_playlist_song_path(@playlist), class: "btn-outline shrink-0" %>
      </div>
    </div>

    <div class="divide-y divide-slate-800">
      <% playlist_songs.each_with_index do |song_item, index| %>
        <%= link_to playlist_song_path(@playlist, song_item), class: "grid grid-cols-[2rem_1fr_3rem_3rem] items-center gap-2 px-4 py-3 text-sm transition hover:bg-slate-800/60 #{'bg-sky-500/15 text-sky-100 ring-1 ring-inset ring-sky-400/40' if song_item == @song}" do %>
          <span class="text-slate-500"><%= index + 1 %></span>
          <span class="truncate font-medium"><%= song_item.name %></span>
          <span class="text-right text-slate-400"><%= song_item.bpm %></span>
          <span class="text-right text-slate-400"><%= song_item.time_signature.presence || "—" %></span>
        <% end %>
      <% end %>
    </div>
  </aside>

  <section class="min-w-0">
    <div class="mb-5 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-normal text-slate-50"><%= @song.name %></h1>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-400">
          <span>Playlist: <%= @playlist.name %></span>
          <span class="text-slate-700">•</span>
          <span>Time: <%= @song.time_signature.presence || "—" %></span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= link_to "✎ Edit Song", edit_playlist_song_path(@playlist, @song), class: "btn-outline border-amber-400/30 text-amber-300 hover:bg-amber-500/10 hover:text-amber-200" %>
        <%= link_to "♪ Manage Assets", playlist_song_assets_path(@playlist, @song), class: "btn-outline border-emerald-400/30 text-emerald-300 hover:bg-emerald-500/10 hover:text-emerald-200" %>
        <%= link_to "← Back", playlist_path(@playlist), class: "btn-outline" %>
      </div>
    </div>

    <div
      data-controller="metronome"
      data-metronome-playlist-id-value="<%= @playlist.id %>"
      data-metronome-song-id-value="<%= @song.id %>"
      data-metronome-songs-json-value="<%= playlist_songs.map { |s| { id: s.id, url: playlist_song_path(@playlist, s) } }.to_json %>"
    >
      <input type="hidden" data-metronome-target="bpm" value="<%= @song.bpm %>">
      <input type="hidden" data-metronome-target="timeSignature" value="<%= @song.time_signature %>">

      <div class="panel mb-5 p-4">
        <div class="grid gap-4 lg:grid-cols-[9.5rem_1fr] lg:items-stretch">
          <button
            data-action="click->metronome#toggle"
            data-metronome-target="toggleButton"
            class="inline-flex h-full min-h-24 w-full items-center justify-center rounded-lg border border-sky-300/30 bg-sky-500 px-8 text-base font-bold uppercase tracking-wide text-white shadow-lg shadow-sky-950/40 transition hover:bg-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-300/50"
          >
            <span data-playing-hidden>▶ Start</span>
            <span data-playing-shown style="display: none;">■ Stop</span>
          </button>

          <div class="grid gap-3 md:grid-cols-4">
            <div class="metric-tile">
              <div class="metric-label">BPM</div>
              <div class="metric-value"><%= @song.bpm %></div>
            </div>
            <div class="metric-tile">
              <div class="metric-label">Time Signature</div>
              <div class="metric-value"><%= @song.time_signature.presence || "—" %></div>
            </div>
            <div class="metric-tile">
              <div class="metric-label">Accent</div>
              <div class="metric-value">1</div>
            </div>
            <div class="metric-tile">
              <label for="volume" class="metric-label">Volume</label>
              <input
                id="volume"
                class="mt-3 w-full"
                type="range"
                min="0"
                max="1"
                step="0.01"
                value="1"
                data-action="input->metronome#setVolume"
                data-metronome-target="volume"
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if @song.lyrics.present? %>
      <div class="panel mb-5 overflow-hidden" data-controller="lyrics">
        <div class="flex items-center justify-between border-b border-slate-800 px-4 py-3">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Lyrics</h2>
          <%= link_to "✎ Edit Lyrics", edit_playlist_song_path(@playlist, @song), class: "link-edit text-sm" %>
        </div>
        <pre data-lyrics-target="container" class="h-[24rem] overflow-y-auto whitespace-pre-wrap bg-slate-950/20 p-5 font-mono text-lg leading-8 text-slate-100 sm:text-xl"><%= @song.lyrics %></pre>
      </div>
    <% end %>

    <div class="panel overflow-hidden" data-controller="song-assets-hint">
      <div class="flex flex-col gap-3 border-b border-slate-800 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Reference Tracks</h2>
          <p class="mt-1 text-xs text-slate-500">Keyboard shortcuts: <strong>1–9</strong> = play reference, <strong>S</strong> = stop all</p>
        </div>
        <%= link_to "＋ Add Track", playlist_song_assets_path(@playlist, @song), class: "link-success text-sm font-semibold" %>
      </div>

      <% if @song.assets.any? %>
        <div class="overflow-x-auto">
          <table class="w-full table-auto border-collapse">
            <thead>
              <tr class="table-head-row">
                <th class="w-10 p-3 text-left">#</th>
                <th class="p-3 text-left">Title</th>
                <th class="p-3 text-left">Audio</th>
              </tr>
            </thead>
            <tbody>
              <% @song.assets.rank(:row_order).each_with_index do |asset, index| %>
                <tr class="table-row">
                  <td class="p-3 text-slate-500"><%= index + 1 %></td>
                  <td class="p-3 font-medium text-slate-200"><%= asset.name.presence || "Track" %></td>
                  <td class="p-3">
                    <% if asset.file.attached? %>
                      <audio
                        controls
                        class="w-full min-w-64"
                        style="height: 32px;"
                        data-song-assets-hint-target="audio"
                      >
                        <source src="<%= url_for(asset.file) %>" type="<%= asset.file.content_type %>">
                        Your browser does not support the audio element.
                      </audio>
                    <% else %>
                      <span class="muted-text">No audio file</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-4 py-6 text-sm text-slate-400">No reference tracks yet.</div>
      <% end %>
    </div>
  </section>
</div>
