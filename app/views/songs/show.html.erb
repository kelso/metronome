<div class="grid gap-6 lg:grid-cols-[16rem_1fr]">
  <!-- Sidebar -->
  <aside class="panel p-4">
    <h3 class="text-lg font-semibold mb-1">
      <%= link_to @playlist.name, playlist_path(@playlist), class: "link-primary" %>
    </h3>
    <p class="text-sm muted-text mb-3">Songs</p>
    <ul class="space-y-1">
      <% @playlist.songs.rank(:row_order).each do |song_item| %>
        <li>
          <%= link_to playlist_song_path(@playlist, song_item), class: "block rounded-lg px-3 py-2 text-sm transition hover:bg-slate-800/70 #{'border border-sky-400/40 bg-sky-500/15 font-semibold text-sky-100' if song_item == @song}" do %>
            <%= song_item.name %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </aside>

  <!-- Main content -->
  <section class="min-w-0">
    <div class="mb-4 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-3xl font-bold tracking-normal text-slate-50"><%= @song.name %></h2>
        <div class="mt-2 flex flex-wrap gap-4 text-sm text-slate-300">
          <p><strong class="text-slate-100">BPM:</strong> <%= @song.bpm %></p>
          <p><strong class="text-slate-100">Time Signature:</strong> <%= @song.time_signature %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-2 text-sm">
        <%= link_to "✏️ Edit", edit_playlist_song_path(@playlist, @song), class: "link-edit" %>
        <%= link_to "🎵 Manage Assets", playlist_song_assets_path(@playlist, @song), class: "link-success" %>
        <%= link_to "← Back to Playlist", playlist_path(@playlist), class: "link-primary" %>
      </div>
    </div>

    <% if @song.lyrics.present? %>
      <div class="mb-6" data-controller="lyrics">
        <h3 class="text-lg font-semibold mb-2 text-slate-100">Lyrics</h3>
        <pre data-lyrics-target="container" class="panel h-[calc(2rem*10)] overflow-y-auto whitespace-pre-wrap p-4 font-mono text-2xl leading-8 text-slate-100"><%= @song.lyrics %></pre>
      </div>
    <% end %>

    <div
      data-controller="metronome"
      data-metronome-playlist-id-value="<%= @playlist.id %>"
      data-metronome-song-id-value="<%= @song.id %>"
      data-metronome-songs-json-value="<%= @playlist.songs.order(:row_order).map { |s| { id: s.id, url: playlist_song_path(@playlist, s) } }.to_json %>"
    >
      <input type="hidden" data-metronome-target="bpm" value="<%= @song.bpm %>">
      <input type="hidden" data-metronome-target="timeSignature" value="<%= @song.time_signature %>">

      <div class="panel mb-6 flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between">
        <button
          data-action="click->metronome#toggle"
          data-metronome-target="toggleButton"
          class="btn-success"
        >
          <span data-playing-hidden>▶️ Start</span>
          <span data-playing-shown style="display: none;">⏹ Stop</span>
        </button>

        <div class="flex flex-1 items-center gap-3 sm:max-w-md">
          <label for="volume" class="text-sm font-medium text-slate-300">Volume</label>
          <input
            id="volume"
            class="w-full"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
            data-action="input->metronome#setVolume"
            data-metronome-target="volume"
          >
        </div>
      </div>
    </div>

    <% if @song.assets.any? %>
      <div data-controller="song-assets-hint">
        <div class="panel mt-6 p-4">
          <h3 class="text-lg font-semibold mb-3 text-slate-100">Song Reference Tracks</h3>
          <ul class="divide-y divide-slate-800">
            <% @song.assets.rank(:row_order).each do |asset| %>
              <li class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:gap-4">
                <span class="min-w-24 text-sm font-medium text-slate-300"><%= asset.name.presence || "Track" %></span>
                <% if asset.file.attached? %>
                  <audio
                    controls
                    class="w-full sm:flex-1"
                    style="height: 32px;"
                    data-song-assets-hint-target="audio"
                  >
                    <source src="<%= url_for(asset.file) %>" type="<%= asset.file.content_type %>">
                    Your browser does not support the audio element.
                  </audio>
                <% else %>
                  <span class="muted-text">No audio file</span>
                <% end %>
              </li>
            <% end %>
          </ul>
          <div class="muted-text mt-3 text-xs">
            Keyboard shortcuts: <strong>1–9</strong> = play reference, <strong>S</strong> = stop all
          </div>
        </div>
      </div>
    <% end %>
  </section>
</div>
