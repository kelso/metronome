<%= form_with(model: [@playlist, @song], class: "space-y-4") do |f| %>
  <div>
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>

  <div>
    <%= f.label :bpm, class: "form-label" %>
    <%= f.number_field :bpm, min: 1, class: "form-input" %>
  </div>

  <div>
    <%= f.label :time_signature, class: "form-label" %>
    <%= f.text_field :time_signature, placeholder: "e.g. 4/4", class: "form-input" %>
  </div>

  <div>
    <%= f.label :lyrics, class: "form-label" %>
    <%= f.text_area :lyrics, rows: 5, class: "form-input" %>
  </div>

  <div>
    <%= f.submit class: "btn-success" %>
  </div>
<% end %>
