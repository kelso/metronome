<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold mb-4 text-slate-50">Manage Assets for <%= @song.name %></h1>

  <%= link_to "← Back to Song", playlist_song_path(@playlist, @song), class: "link-primary mb-4 block" %>

  <!-- Upload new asset form -->
  <div class="panel mb-8 p-4">
    <h2 class="text-lg font-semibold mb-2 text-slate-100">Add New Asset</h2>
    <%= form_with(model: [@playlist, @song, Asset.new], local: true, html: { multipart: true }) do |f| %>
      <div class="mb-2">
        <%= f.label :name, "Description/Name", class: "form-label" %>
        <%= f.text_field :name, class: "form-input" %>
      </div>
      <div class="mb-2">
        <%= f.label :file, "Audio File", class: "form-label" %>
        <%= f.file_field :file, class: "form-input" %>
      </div>
      <div>
        <%= f.submit "Upload", class: "btn-success" %>
      </div>
    <% end %>
  </div>

  <!-- Assets table -->
  <h2 class="text-lg font-semibold mb-2 text-slate-100">Uploaded Assets</h2>
  <table class="table-shell table-auto border-collapse">
    <thead>
      <tr class="table-head-row">
        <th class="text-left p-2">Order</th>
        <th class="text-left p-2">Name</th>
        <th class="text-left p-2">Audio</th>
        <th class="text-left p-2">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @assets.each_with_index do |asset, index| %>
        <tr class="table-row">
          <td class="p-2">
            <% if index > 0 %>
              <%= link_to "⬆", move_up_playlist_song_asset_path(@playlist, @song, asset), data: { turbo_method: :patch }, class: "text-slate-400 transition hover:text-sky-300", title: "Move Up" %>
            <% end %>
            <% if index < @assets.size - 1 %>
              <%= link_to "⬇", move_down_playlist_song_asset_path(@playlist, @song, asset), data: { turbo_method: :patch }, class: "text-slate-400 transition hover:text-sky-300", title: "Move Down" %>
            <% end %>
          </td>
          <td class="p-2"><%= asset.name.presence || "—" %></td>
          <td class="p-2">
            <% if asset.file.attached? %>
              <audio controls style="height: 32px;">
                <source src="<%= url_for(asset.file) %>" type="<%= asset.file.content_type %>">
                Your browser does not support the audio element.
              </audio>
            <% else %>
              <span class="muted-text">No file</span>
            <% end %>
          </td>
          <td class="p-2 space-x-2">
            <%= link_to "✏️ Edit", edit_playlist_song_asset_path(@playlist, @song, asset), class: "link-edit" %>
            <%= link_to "🗑 Delete", playlist_song_asset_path(@playlist, @song, asset), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "link-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
