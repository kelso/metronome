<div class="panel mx-auto max-w-xl p-6">
  <h1 class="text-2xl font-bold mb-4 text-slate-50">Edit Asset for <%= @song.name %></h1>
  <%= link_to "← Back to Assets", playlist_song_assets_path(@playlist, @song), class: "link-primary mb-4 block" %>

  <%= form_with(model: [@playlist, @song, @asset], local: true, html: { multipart: true }) do |f| %>
    <div class="mb-2">
      <%= f.label :name, "Description/Name", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", value: @asset.name %>
    </div>
    <div class="mb-2">
      <%= f.label :file, "Audio File", class: "form-label" %>
      <% if @asset.file.attached? %>
        <p class="mb-1 text-sm text-slate-300">Current: <%= @asset.file.filename %></p>
        <audio controls style="height: 32px;">
          <source src="<%= url_for(@asset.file) %>" type="<%= @asset.file.content_type %>">
        </audio>
      <% end %>
      <%= f.file_field :file, class: "form-input" %>
      <p class="muted-text text-xs">Leave blank to keep current file.</p>
    </div>
    <div>
      <%= f.submit "Save Changes", class: "btn-edit" %>
    </div>
  <% end %>
</div>
