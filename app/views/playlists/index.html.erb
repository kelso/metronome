<div class="mx-auto max-w-5xl">
  <div class="mb-5 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-50">Playlists</h1>

    <%= link_to "➕ New Playlist", new_playlist_path, class: "btn-primary" %>
  </div>

  <table class="table-shell table-auto border-collapse">
    <thead>
      <tr class="table-head-row">
        <th class="text-left p-2">Name</th>
        <th class="text-left p-2">Created At</th>
        <th class="text-left p-2">Updated At</th>
        <th class="text-left p-2">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @playlists.each do |playlist| %>
        <tr class="table-row">
          <td class="p-2">
            <%= link_to playlist.name, playlist_path(playlist), class: "link-primary" %>
          </td>
          <td class="p-2"><%= playlist.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="p-2"><%= playlist.updated_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="p-2 space-x-2">
            <%= link_to "✏️ Edit", edit_playlist_path(playlist), class: "link-edit" %>
            <%= link_to "🗑 Delete", playlist_path(playlist), data: { turbo_method: :delete,  turbo_confirm: "Are you sure?" }, class: "link-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
